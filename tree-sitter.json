{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rotom",
      "camelcase": "Rotom",
      "title": "Rotom",
      "scope": "source.rotom",
      "file-types": [
        "rotom"
      ],
      "injection-regex": "^rotom$",
      "class-name": "TreeSitterRotom"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Grammar for the Rotom Pokemon scripting language",
    "authors": [
      {
        "name": "Kalaay",
        "email": "contact@kalaay.dev",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/KalaayPT/tree-sitter-rotom",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}